{
  "name": "@perfect-draw/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:offline": "playwright test -c playwright.pwa.config.ts",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "vision-eval": "tsx --tsconfig tsconfig.app.json scripts/vision-eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.14.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@perfect-draw/engine": "workspace:*",
    "@perfect-draw/paytables": "workspace:*",
    "@perfect-draw/precomputed": "workspace:*",
    "@perfect-draw/shared": "workspace:*",
    "comlink": "^4.4.2",
    "dexie": "^4.0.10",
    "echarts": "^6.1.0",
    "heic-to": "1.6.7",
    "openai": "7.64.0",
    "pdf-lib": "1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^5.1.1"
  }
}
